# Environment Variables Template
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=restaurant_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/restaurant_db
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/restaurant_db

REDIS_URL=redis://localhost:6379/0

SECRET_KEY=SUPER_SECRET_JWT_KEY_FOR_RESTAURANT_SYSTEM_CHANGE_IN_PROD_123456789
REFRESH_SECRET_KEY=SUPER_SECRET_REFRESH_KEY_FOR_RESTAURANT_SYSTEM_CHANGE_IN_PROD_987654321
ALGORITHM=HS256

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
